{
  "_comment": "Siege Run tuning. Augments, relics, events and tech all use the same effect list format; see game/systems/run.py (Modifiers) for every effect type.",

  "acts": 3,
  "floors_per_act": 7,
  "floor_width": [2, 4],
  "node_weights": {"combat": 45, "elite": 15, "cache": 15, "event": 25},
  "elite_min_floor": 2,
  "sectors": ["sector1", "sector2", "sector3", "sector4", "sector5", "sector6", "sector7", "sector8",
              "procedural", "procedural"],

  "_waves_comment": "Waves per fight = base + per_act x (act - 1): 10 / 15 / 20. Threat level climbs per_wave per wave inside a fight (0.35 = +1 about every 3 waves); a mutator only rolls on the first wave of a new threat level.",
  "waves_per_node": {"base": 10, "per_act": 5, "max": 30},
  "_enemy_count_comment": "Multiplies every group's enemy count in Siege Run fights. Spawns get tighter (by the square root) so waves are denser, not just longer.",
  "enemy_count_mult": 1.6,
  "wave_depth": {"per_floor": 1, "per_act": 7, "per_wave": 0.35},
  "elite_node_chance": 0.6,
  "boss": "hive_overseer",
  "bosses_by_act": ["hive_overseer", "siege_titan", "hive_queen"],
  "boss_hp_per_act": 0.5,
  "_endless_comment": "After the last act's boss the player can PUSH ON into endless acts. Those acts rotate through endless_bosses.",
  "endless_bosses": ["hive_overseer", "siege_titan", "hive_queen", "burrow_wyrm"],

  "_rarity_comment": "Each draft/relic/shop/event card rolls a tier from odds[source] (weights, not %), then picks a card of that tier. act_bonus multiplies a tier's weight by (1 + bonus x (act - 1)). rarity_luck effects multiply every non-common weight by (1 + luck). price multiplies Supply Cache prices.",
  "rarity": {
    "order": ["common", "rare", "epic", "legendary"],
    "tiers": {
      "common":    {"name": "COMMON",    "color": [190, 198, 210], "price": 1.0},
      "rare":      {"name": "RARE",      "color": [70, 160, 255],  "price": 1.35},
      "epic":      {"name": "EPIC",      "color": [190, 100, 255], "price": 1.8},
      "legendary": {"name": "LEGENDARY", "color": [255, 175, 40],  "price": 2.5}
    },
    "odds": {
      "combat": {"common": 60, "rare": 30, "epic": 9,  "legendary": 1},
      "elite":  {"common": 35, "rare": 40, "epic": 20, "legendary": 5},
      "boss":   {"common": 0,  "rare": 35, "epic": 45, "legendary": 20},
      "shop":   {"common": 50, "rare": 32, "epic": 14, "legendary": 4},
      "event":  {"common": 45, "rare": 35, "epic": 16, "legendary": 4}
    },
    "act_bonus": {"rare": 0.10, "epic": 0.20, "legendary": 0.30}
  },

